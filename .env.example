# Application
APP_NAME=Jokiinlah
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
DISPLAY_TIMEZONE=Asia/Jakarta
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jokiinlah_dev
DB_USERNAME=root
DB_PASSWORD=

# Session dan cookie
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Cache
CACHE_STORE=database
CACHE_PREFIX=jokiinlah_cache_
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Queue
QUEUE_CONNECTION=database
QUEUE_AFTER_COMMIT=true
QUEUE_FAILED_DRIVER=database-uuids
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90

# Mail
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
PRODUCTION_CONTACT_EMAIL=

# Filesystem dan object storage
FILESYSTEM_DISK=local
PRIVATE_FILESYSTEM_DISK=local
UPLOAD_MAX_SIZE=20480
DEFAULT_RETENTION_DAYS=180
LIBREOFFICE_BINARY=
WORD_TO_PDF_MAX_MB=10
WORD_TO_PDF_TIMEOUT=60
WORD_TO_PDF_EXPANDED_MAX_MB=100
WORD_TO_PDF_OUTPUT_MAX_MB=50
WORD_TO_PDF_SANDBOX_VERIFIED=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Malware scanner (wajib dikonfigurasi sebelum production)
MALWARE_SCANNER_ENABLED=false
MALWARE_SCANNER_DRIVER=clamav
MALWARE_SCANNER_HOST=127.0.0.1
MALWARE_SCANNER_PORT=3310
MALWARE_SCANNER_TIMEOUT=10

# HTTP security
TRUSTED_PROXIES=
CORS_ALLOWED_ORIGINS=
SECURITY_HSTS_MAX_AGE=31536000
CSP_REPORT_ONLY=false

# Logging
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# Broadcasting
BROADCAST_CONNECTION=log

# WhatsApp dan identitas aplikasi
WHATSAPP_NUMBER=
PROJECT_CODE_PREFIX=PRJ
CONSULTATION_CODE_PREFIX=CNS
PRIVACY_POLICY_VERSION=2026-07-22
TERMS_VERSION=2026-07-22

# Frontend
VITE_APP_NAME="${APP_NAME}"
